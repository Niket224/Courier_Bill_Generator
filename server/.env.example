# Backend only. Copy to server/.env ONLY if it does not already exist.
# Never expose these values through frontend code or commit real .env files.
MONGO_URI=mongodb://127.0.0.1:27017/courier_bill_generator
# Optional; required only for Gemini PDF rate-card extraction.
GEMINI_API_KEY=
# Documented model; verify account availability in staging before enabling parsing.
GEMINI_MODEL=gemini-2.5-flash
# Per-attempt timeout (1000-10000 ms); overall parsing budget is 25 seconds.
GEMINI_TIMEOUT_MS=8000
# Transient retries only (0-2); authentication and quota errors are not retried.
GEMINI_RETRIES=2
PORT=5000
# development or production. test is reserved for the isolated test harness.
NODE_ENV=development
# Explicit frontend origins; no wildcard, paths, credentials or trailing slash.
# Production requires HTTPS and must list the actual public UI origin.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Required single operator identity; no public signup.
ADMIN_USERNAME=operator
# Required: run npm run admin:hash --prefix server in an interactive terminal.
# Paste the generated scrypt hash here, preserving the single quotes.
ADMIN_PASSWORD_HASH=
# Required: independent random base64url secret, 43-128 characters; generated by the same helper.
SESSION_SECRET=
# Required stable independent 32-byte base64 key. Generate once and keep a protected
# recovery copy; changing it makes existing browser drafts unreadable.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BROWSER_DRAFT_KEY=
# Absolute session lifetime in minutes, 5-1440; default 480 (8 hours).
SESSION_TTL_MINUTES=480
# false by default. Use loopback ONLY for a local trusted HTTPS reverse proxy.
# Proxy must overwrite X-Forwarded-* headers; block direct public backend access.
TRUST_PROXY=false

# Browser code has no environment variables. Local frontend server uses shell PORT
# (default 4173), does not load dotenv, and calls port 5000 on the same hostname.
# Tests set NODE_ENV=test and TEST_DB_MODE=memory automatically. Never set test URIs.
