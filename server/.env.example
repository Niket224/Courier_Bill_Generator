# Backend: copy this file to server/.env and configure values locally.
# The backend always loads server/.env; exported environment variables take precedence.
# Never put backend credentials in frontend code.

# Required: MongoDB URI. This local example contains no credentials.
MONGO_URI=mongodb://127.0.0.1:27017/courier_bill_generator

# Optional for startup; required for AI PDF rate-card parsing. Supply your own key.
GEMINI_API_KEY=

# Optional backend listening port (default 5000), integer 1-65535.
PORT=5000

# Optional runtime mode: development (default), production, or test.
# test is reserved for the isolated harness; the normal server refuses this mode.
NODE_ENV=development

# Optional extra CORS origins, comma-separated, without paths or trailing slashes.
# Current server policy already permits all origins; this does not restrict it.
ALLOWED_ORIGINS=http://localhost:4173

# Frontend browser code reads no environment variables; API_BASE is defined in app.js.
# Frontend development server uses only PORT (default 4173) from the shell.
# It does not load .env files. Example PowerShell: $env:PORT='4173'; npm run dev

# Integration harness only: set automatically by npm run test:integration.
# TEST_DB_MODE=memory
# No TEST_MONGO_URI is supported; external database URIs are deliberately rejected.
