{
  "name": "courier-bill-server",
  "version": "1.0.0",
  "description": "Node.js Express backend for Courier Bill Generator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm --prefix .. test",
    "test:unit": "npm --prefix .. run test:unit",
    "test:integration": "npm --prefix .. run test:integration",
    "test:e2e": "npm --prefix .. run test:e2e",
    "test:coverage": "npm --prefix .. run test:coverage",
    "admin:hash": "node scripts/hash-admin-password.js"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "connect-mongo": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongoose": "^8.3.1",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1"
  },
  "overrides": {
    "qs": "6.16.2"
  }
}
