# Independent scheduler environment, NOT loaded by the application or CLI automatically.
# No scheduler is installed. Approval and real secured locations must be supplied by the operator.
BACKUP_JOB_APPROVED=no
BACKUP_SOURCE_URI=
BACKUP_SOURCE_DB=
BACKUP_KEY_FILE=
BACKUP_LOCAL_DIR=
# A mounted off-host encrypted destination; a different directory alone does not prove independence.
BACKUP_COPY_DIR=
# Planning only: the job never deletes archives.
BACKUP_RETAIN_COUNT=7
BACKUP_MAX_AGE_HOURS=24
BACKUP_MIN_FREE_MB=256
BACKUP_STATUS_FILE=
MONITOR_BASE_URL=https://billing.example.test
