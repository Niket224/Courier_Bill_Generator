}

function shipmentInput(id, field, label, value, type = "text", inputmode = "text") {
  return `
    <label>
      ${label}
      <input data-id="${id}" data-field="${field}" data-kind="shipment" type="${type}" inputmode="${inputmode}" value="${escapeHtml(value ?? "")}" />
    </label>
  `;
}

function shipmentDestinationInput(shipment) {
  const destinations = Array.from(new Set(state.rates.map((rate) => rate.destination).filter(Boolean)));
  if (shipment.destination && !destinations.includes(shipment.destination)) destinations.unshift(shipment.destination);
  return `
    <label>
      Destination
      <select data-id="${shipment.id}" data-field="destination" data-kind="shipment">
        ${destinations.map((destination) => `<option value="${escapeHtml(destination)}" ${destination === shipment.destination ? "selected" : ""}>${escapeHtml(destination)}</option>`).join("")}
      </select>
    </label>
  `;
}

