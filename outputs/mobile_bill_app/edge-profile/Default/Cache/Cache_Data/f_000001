function renderAll() {
  renderSummary();
  renderInvoice();
}

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function addRate() {
  state.rates.push({ id: cryptoId(), client: state.bill.shipperCode || "", destination: "", baseKg: 3, baseRate: 0, perKgRate: 0 });
  saveState();
  renderRates();
  renderShipments();
  renderAll();
}

function addShipment() {
  const firstDestination = state.rates.find((rate) => normalize(rate.client) === normalize(state.bill.shipperCode))?.destination || "";
  state.shipments.push({ id: cryptoId(), cno: "", date: state.bill.invoiceDate, destination: firstDestination, type: "D", pcs: 1, weight: 0.1, manualAmount: "" });
  saveState();
  renderShipments();
  renderAll();
}

function newBill() {
  if (!confirm("Sirf shipment rows clear hongi. Rates safe rahenge. Continue?")) return;
  state.shipments = [];
  saveState();
  renderShipments();
  renderAll();
}

function updateShipmentCard(shipment) {
  const card = document.querySelector(`.shipment-card[data-id="${shipment.id}"]`);
  if (!card) return;
  const result = calculateShipment(shipment);
  const amount = card.querySelector(".amount-pill");
  const subtitle = card.querySelector(".card-subtitle");
  if (amount) {
    amount.classList.toggle("error", result.status === "missing");
    amount.textContent = result.status === "missing" ? "CHECK RATE" : money(result.amount);
  }
  if (subtitle) {
    subtitle.textContent = `${shipment.destination || "No destination"} - ${formatDate(shipment.date)}`;
  }
}

function updateAllShipmentCards() {
  state.shipments.forEach(updateShipmentCard);
}

function handleLiveInput(event) {
  const target = event.target;
  const id = target.dataset.id;
  const field = target.dataset.field;
  const kind = target.dataset.kind;
  if (!id || !field || !kind) return;

  const collection = kind === "rate" ? state.rates : state.shipments;
  const item = collection.find((entry) => entry.id === id);
  if (!item) return;

  item[field] = target.value;
  saveState();
  if (kind === "rate") {
    updateAllShipmentCards();
  } else {
    updateShipmentCard(item);
  }
  renderAll();
}

function handleCommittedChange(event) {
  handleLiveInput(event);
  const kind = event.target.dataset.kind;
  if (kind === "rate") {
    renderRates();
    renderShipments();
  }
  if (kind === "shipment") {
    renderShipments();
  }
  renderAll();
}

function handleDelete(event) {
  const button = event.target.closest("button[data-action]");
  if (!button) return;
  const card = button.closest("[data-id]");
  const id = card?.dataset.id;
  if (!id) return;

  if (button.dataset.action === "delete-rate") {
    state.rates = state.rates.filter((rate) => rate.id !== id);
    renderRates();
    renderShipments();
  }
  if (button.dataset.action === "delete-shipment") {
    state.shipments = state.shipments.filter((shipment) => shipment.id !== id);
    renderShipments();
  }
  saveState();
  renderAll();
}

function switchScreen(target) {
  document.querySelectorAll(".screen").forEach((screen) => {
    screen.classList.toggle("active", screen.dataset.screen === target);
  });
  document.querySelectorAll(".nav-item").forEach((item) => {
    item.classList.toggle("active", item.dataset.target === target);
  });
  if (target === "invoice") renderInvoice();
}

function exportData() {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = `courier-bill-backup-${new Date().toISOString().slice(0, 10)}.json`;
  link.click();
  URL.revokeObjectURL(url);
}

function importData(file) {
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const imported = JSON.parse(String(reader.result));
      state = {
        ...structuredClone(defaultState),
        ...imported,
        bill: { ...defaultState.bill, ...imported.bill },
      };
      saveState();
      init(false);
    } catch {
      alert("Backup file read nahi ho paayi.");
    }
  };
  reader.readAsText(file);
}

function setupInstallPrompt() {
  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();
    deferredInstallPrompt = event;
    document.getElementById("installButton").hidden = false;
  });

  document.getElementById("installButton").addEventListener("click", async () => {
    if (!deferredInstallPrompt) return;
    deferredInstallPrompt.prompt();
    await deferredInstallPrompt.userChoice;
    deferredInstallPrompt = null;
    document.getElementById("installButton").hidden = true;
  });
}

function registerServiceWorker() {
  if ("serviceWorker" in navigator && location.protocol !== "file:") {
    navigator.serviceWorker.register("sw.js").catch(() => {});
  }
}

function init(bind = true) {
  renderShipperOptions();
  billFields.forEach((field) => {
    const input = document.getElementById(field);
    input.value = state.bill[field] ?? "";
  });
  renderRates();
  renderShipments();
  renderAll();

  if (!bind) return;
  bindBillForm();
  document.getElementById("rateList").addEventListener("input", handleLiveInput);
  document.getElementById("shipmentList").addEventListener("input", handleLiveInput);
  document.getElementById("rateList").addEventListener("change", handleCommittedChange);
  document.getElementById("shipmentList").addEventListener("change", handleCommittedChange);
  document.getElementById("rateList").addEventListener("click", handleDelete);
  document.getElementById("shipmentList").addEventListener("click", handleDelete);
  document.getElementById("addRateButton").addEventListener("click", addRate);
  document.getElementById("addShipmentButton").addEventListener("click", addShipment);
  document.getElementById("newBillButton").addEventListener("click", newBill);
  document.getElementById("printButton").addEventListener("click", () => window.print());
  document.getElementById("exportButton").addEventListener("click", exportData);
  document.getElementById("importInput").addEventListener("change", (event) => {
    const file = event.target.files?.[0];
    if (file) importData(file);
  });
  document.querySelectorAll(".nav-item").forEach((button) => {
    button.addEventListener("click", () => switchScreen(button.dataset.target));
  });
  setupInstallPrompt();
  registerServiceWorker();
}

init();
